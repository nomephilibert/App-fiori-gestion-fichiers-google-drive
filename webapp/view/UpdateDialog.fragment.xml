<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:u="sap.ui.unified">
  <Dialog title="Modifier le fichier" contentWidth="26rem">
    <content>
      <VBox class="sapUiSmallMargin">
        <Text text="Le contenu sera remplacé et le fichier prendra le nom du fichier choisi."/>
        <u:FileUploader id="updateUploader" width="100%" change=".onFileChange"
          placeholder="Sélectionner le nouveau fichier…"/>
      </VBox>
    </content>
    <beginButton><Button text="Remplacer" type="Emphasized" press=".onUpdateConfirm"/></beginButton>
    <endButton><Button text="Annuler" press=".onUpdateCancel"/></endButton>
  </Dialog>
</core:FragmentDefinition>
<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:u="sap.ui.unified">
  <Dialog title="Uploader un fichier" contentWidth="26rem">
    <content>
      <VBox class="sapUiSmallMargin">
        <Text text="Choisis un fichier à envoyer à la racine de Mon Drive."/>
        <u:FileUploader id="fileUploader" width="100%" change=".onFileChange"
          placeholder="Sélectionner un fichier…"/>
      </VBox>
    </content>
    <beginButton><Button text="Envoyer" type="Emphasized" press=".onUploadConfirm"/></beginButton>
    <endButton><Button text="Annuler" press=".onUploadCancel"/></endButton>
  </Dialog>
</core:FragmentDefinition>